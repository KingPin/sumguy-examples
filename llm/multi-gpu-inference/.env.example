# Copy to .env and edit.
MODELS_DIR=/srv/models
HF_CACHE_DIR=/srv/hf-cache

# llama.cpp: file inside MODELS_DIR, and the VRAM ratio per GPU (24 GB + 12 GB = 2,1)
GGUF_FILE=Qwen3.6-27B-Q8_0.gguf
TENSOR_SPLIT=2,1
CTX_SIZE=16384

# vLLM: Hugging Face repo and GPU count (must divide the attention head count)
VLLM_MODEL=Qwen/Qwen3.6-27B-FP8
TP_SIZE=2
HF_TOKEN=

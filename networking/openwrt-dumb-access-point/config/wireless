config wifi-device 'radio0'
	option type 'mac80211'
	option channel '36'
	option band '5g'
	option htmode 'HE80'
	option disabled '0'
	option country 'US'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'HomeWiFi'
	option encryption 'psk2'
	option key 'change-this-passphrase'

config wifi-iface 'guest'
	option device 'radio0'
	option mode 'ap'
	option network 'guest'
	option ssid 'HomeWiFi-Guest'
	option encryption 'psk2'
	option key 'change-this-guest-key'
	option isolate '1'

config wifi-iface 'iot'
	option device 'radio0'
	option mode 'ap'
	option network 'iot'
	option ssid 'HomeWiFi-IoT'
	option encryption 'psk2'
	option key 'change-this-iot-key'

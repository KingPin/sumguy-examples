{
	servers {
		# The usual fix for "everyone has the CDN's IP": trust forwarded headers. 0.0.0.0/0 believes
		# any sender, including a client that skips the CDN.
		trusted_proxies static 0.0.0.0/0
	}
}

# The trap config plus a real-IP setup that trusts every source.
# Needs a Caddy built with github.com/mholt/caddy-ratelimit (Dockerfile.caddy). Stock Caddy rejects rate_limit.
app.example.test {
	tls /certs/app.crt /certs/app.key
	header -Server
	header -Via
	header {
		>Strict-Transport-Security "max-age=63072000"
		>X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		+Content-Security-Policy "frame-ancestors 'self'"
	}

	rate_limit {
		zone login {
			match {
				method POST
				path /login
			}
			# {client_ip} honours trusted_proxies
			key {client_ip}
			events 5
			window 1m
		}
		zone api {
			match {
				path /api/*
			}
			key {client_ip}
			events 20
			window 2s
		}
	}

	reverse_proxy backend:8080 {
		header_down -X-Powered-By

		@error status 5xx
		handle_response @error {
			respond "Something went wrong." {rp.status_code}
		}
	}
}

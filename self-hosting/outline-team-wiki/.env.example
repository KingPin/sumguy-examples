# Copy to .env, then fill the three secrets:
#   openssl rand -hex 32
SECRET_KEY=replace_with_openssl_rand_hex_32
UTILS_SECRET=replace_with_openssl_rand_hex_32
OIDC_CLIENT_SECRET=replace_with_openssl_rand_hex_32
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32

# Outline core
URL=http://localhost:3000
PORT=3000
FORCE_HTTPS=false
DATABASE_URL=postgres://outline:${POSTGRES_PASSWORD}@postgres:5432/outline
PGSSLMODE=disable
REDIS_URL=redis://redis:6379

# Local file storage (the compose file mounts a volume here)
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data

# OIDC via Dex (automatic discovery)
OIDC_ISSUER_URL=http://dex.localtest.me:5556/dex
OIDC_CLIENT_ID=outline
OIDC_DISPLAY_NAME=Dex

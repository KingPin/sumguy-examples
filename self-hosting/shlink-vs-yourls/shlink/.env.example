# Copy to .env and edit.
DEFAULT_DOMAIN=localhost:8080
IS_HTTPS_ENABLED=false
# Free key from maxmind.com. Leave empty to skip GeoLite2 (visits get no country/city).
GEOLITE_LICENSE_KEY=
# Generate with: openssl rand -hex 24
INITIAL_API_KEY=change-me-to-a-long-random-string
DB_PASSWORD=change-me-too
SHLINK_PORT=8080
WEB_CLIENT_PORT=8000
# The URL your BROWSER uses to reach Shlink (the web client runs in the browser).
SHLINK_SERVER_URL=http://localhost:8080

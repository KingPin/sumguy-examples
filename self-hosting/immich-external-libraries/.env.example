# Merge these lines into your existing .env. Do not replace it: the DB_* credentials still come from the stock example.env.
# Immich's own storage: uploads, thumbnails, encoded video. Local disk.
UPLOAD_LOCATION=/srv/immich/library
# Postgres data. Local disk only, never a network share.
DB_DATA_LOCATION=/srv/immich/postgres
# Tracks the v3 major line. Pin a full version (for example v3.4.2) to make upgrades deliberate.
IMMICH_VERSION=v3

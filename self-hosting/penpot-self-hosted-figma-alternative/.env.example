# Copy to .env and change every value marked CHANGE-ME.
PENPOT_VERSION=2.19.1
# Host port for the frontend container (container side is 8080).
PENPOT_HOST_PORT=9001
# Must match the URL people type in the browser (include https:// behind a proxy).
PENPOT_PUBLIC_URI=http://localhost:9001
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=CHANGE-ME
POSTGRES_PASSWORD=CHANGE-ME
# Local http test: "disable-secure-session-cookies". Behind HTTPS: leave empty.
PENPOT_COOKIE_FLAG=disable-secure-session-cookies
